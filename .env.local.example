# =============================================
# LawAI - 环境变量配置
# =============================================
# 复制此文件为 .env.local 并填入真实的配置值

# ----- Auth0 配置 -----
# 从 Auth0 Dashboard > Applications > Settings 获取
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your_auth0_domain
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# 64位随机字符串，用于加密会话 Cookie
# 生成命令: openssl rand -hex 32
AUTH0_SECRET=your_64_char_random_secret_here

# ----- Auth0 FGA (细粒度授权) -----
# 从 Auth0 Dashboard > FGA > Settings 获取
AUTH0_FGA_API_URL=https://api.us1.fga.dev
AUTH0_FGA_TOKEN_ISSUER=auth.fga.dev
AUTH0_FGA_AUDIENCE=https://api.us1.fga.dev/
AUTH0_FGA_STORE_ID=your_fga_store_id
AUTH0_FGA_CLIENT_ID=your_fga_client_id
AUTH0_FGA_CLIENT_SECRET=your_fga_client_secret
AUTH0_FGA_TIMEOUT_MS=5000

# 管理权限来自 Auth0 permission/role 或显式 subject allowlist。
# 不要在此文件提交真实 subject。
AUTH0_ADMIN_PERMISSION=read:admin_activity
AUTH0_ADMIN_ROLE=admin
AUTH0_PERMISSIONS_CLAIM=permissions
AUTH0_ROLES_CLAIM=roles
ADMIN_AUTH0_SUBJECTS=

# ----- DeepSeek AI (对话模型) -----
# 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=your_deepseek_api_key
# 可用模型: deepseek-chat, deepseek-reasoner
AI_MODEL=deepseek-chat

# ----- MongoDB -----
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
MONGODB_AUTO_INDEX=false

# ----- Pinecone (向量数据库) -----
PINECONE_API_KEY=your_pinecone_api_key
HOST_ADD=your_pinecone_host
PINECONE_INDEX_NAME=finalindex
PINECONE_NAMESPACE=caselist
# Pinecone 推理模型 (用于生成文本嵌入向量)
PINECONE_EMBEDDING_MODEL=multilingual-e5-large

# ----- 可选 -----
# NODE_ENV=development
