{
  "name": "lawai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=/integration/",
    "test:integration": "jest --runInBand __tests__/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "npm run test:e2e:external",
    "test:e2e:external": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "test:ai": "npm run test:ai:external",
    "test:ai:external": "tsx e2e/report/index.ts",
    "test:ai-eval": "npm run test:ai:external",
    "fga:model:status": "tsx scripts/manage-fga-model.ts --dry-run",
    "fga:model:apply": "tsx scripts/manage-fga-model.ts --apply",
    "data:migrate:dry-run": "tsx scripts/migrate-document-metadata.ts --dry-run",
    "data:evidence": "tsx scripts/report-data-evidence.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:secrets:working-tree": "node scripts/scan-secrets.mjs --working-tree-only"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.20.0",
    "@pinecone-database/pinecone": "^5.1.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "driver.js": "^1.3.1",
    "fuse.js": "^7.1.0",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11",
    "lodash": "^4.17.21",
    "mongodb": "^6.11.0",
    "mongoose": "^8.8.3",
    "next": "^15.5.21",
    "openai": "^6.37.0",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primereact": "^10.8.5",
    "rate-limiter-flexible": "^5.0.4",
    "react": "^19.0.1",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^19.0.1",
    "react-intersection-observer": "^9.13.1",
    "react-markdown": "^9.0.1",
    "react-swipeable": "^7.0.2",
    "rehype-highlight": "^7.0.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/jest": "^29.5.14",
    "@types/katex": "^0.16.7",
    "@types/lodash": "^4.17.13",
    "@types/node": "^20.17.9",
    "@types/react": "19.0.7",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "19.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.21",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
